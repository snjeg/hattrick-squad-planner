DATABASE_URL=sqlite:///./backend/data/hattrick.db
FRONTEND_ORIGIN=http://localhost:5173

# Use mock for local development without CHPP credentials. Use live only for an
# approved CHPP application; never commit real credential values.
CHPP_MODE=mock
CHPP_CONSUMER_KEY=
CHPP_CONSUMER_SECRET=
CHPP_CALLBACK_URL=http://localhost:8000/api/chpp/auth/callback
CHPP_PLAYERS_VERSION=2.7
